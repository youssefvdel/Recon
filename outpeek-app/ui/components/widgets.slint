// Shared app chrome. Same visual family as the HUD: tokens only, no blur,
// layered translucent plates and 1px inner strokes.

import { Theme, TypeScale, Space, Shape, Motion } from "tokens.slint";

export component Chip inherits Rectangle {
    in property <string> text: "";
    // neutral | live | armed | error | off
    in property <string> tone: "neutral";

    height: label.height + 8px;
    width: label.width + 18px;
    border-radius: Shape.pill;
    background: tone == "live"
        ? #a8f5cc1f
        : tone == "armed"
            ? #e8b73a1f
            : tone == "error"
                ? #ffb4ab1f
                : tone == "off"
                    ? #ffffff0d
                    : #d0bcff1a;
    border-width: 1px;
    border-color: tone == "live"
        ? #a8f5cc59
        : tone == "armed"
            ? #e8b73a59
            : tone == "error"
                ? #ffb4ab59
                : #ffffff14;

    label := Text {
        x: 9px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: tone == "live"
            ? Theme.mint
            : tone == "armed"
                ? Theme.amber
                : tone == "error"
                    ? Theme.error
                    : Theme.ink-dim;
    }
}

export component StateDot inherits Rectangle {
    in property <string> tone: "neutral";
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: tone == "ok" || tone == "live"
        ? Theme.mint
        : tone == "warn" || tone == "armed"
            ? Theme.amber
            : tone == "error" || tone == "unsupported"
                ? Theme.coral
                : Theme.ink-faint;
}

export component NavRow inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> soon: false;
    callback clicked();

    height: 40px;
    border-radius: Shape.sm;
    background: active
        ? Theme.container
        : (hover.has-hover && !soon ? Theme.container-low : transparent);

    // Active accent spine, same 2px as the HUD's live spine.
    if active: Rectangle {
        x: 0px;
        y: 10px;
        width: 2px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: Theme.primary;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: Space.sm;

        Text {
            text: root.label;
            font-family: Theme.font-body;
            font-size: TypeScale.body;
            font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.ink : (root.soon ? Theme.ink-faint : Theme.ink-dim);
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.soon: Text {
            text: "SOON";
            font-family: Theme.font-mono;
            font-size: TypeScale.micro;
            letter-spacing: 0.8px;
            color: Theme.ink-faint;
            vertical-alignment: center;
        }
    }

    hover := TouchArea {
        enabled: !root.soon;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component HudToggle inherits Rectangle {
    in property <bool> checked: false;
    callback toggled();

    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: checked ? #d0bcff33 : Theme.container-high;
    border-width: 1px;
    border-color: checked ? Theme.primary : Theme.line;

    knob := Rectangle {
        x: checked ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: checked ? Theme.primary : Theme.ink-faint;
        animate x { duration: Motion.fast; easing: ease-in-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line-soft;
}

/// Small text button (rank refresh). Disabled colour when `enabled` is false.
export component LinkButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    callback clicked();

    height: label.height + 8px;
    width: label.width + 16px;
    border-radius: Shape.pill;
    background: hover.has-hover && enabled ? #ffffff10 : transparent;
    border-width: 1px;
    border-color: enabled ? Theme.line : transparent;

    label := Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: enabled ? Theme.primary : Theme.ink-faint;
    }

    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
