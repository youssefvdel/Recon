{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Recon",
  "version": "../package.json",
  "identifier": "com.recon.utility",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Recon \u2022 Stretched Resolution & Utility",
        "width": 1210,
        "height": 800,
        "minWidth": 1210,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "",
        "url": "index.html#overlay",
        "fullscreen": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "dev",
        "title": "Recon \u2022 Dev Dashboard",
        "url": "index.html#dev",
        "width": 1080,
        "height": 780,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Youssef Adel",
    "copyright": "Copyright \u00a9 2026 Youssef Adel. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Valorant Stretched Resolution & Scouting Utility",
    "longDescription": "Recon is a competitive stretched resolution utility and real-time scout for Valorant.",
    "homepage": "https://recon.qd.je",
    "licenseFile": "../LICENSE",
    "externalBin": [],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/youssefvdel/Recon/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMTBGNDc1NUYxN0NDMTIKUldRU3pCZGZkZlFRMi9RSHBSUzZYTWZGNjJWQXQ1Mk1RSkg0a0Fia080WVBlbThBU0NhVDltY3AK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
