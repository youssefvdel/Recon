{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Recon",
  "version": "../package.json",
  "identifier": "com.recon.utility",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "bun run dev:ui",
    "beforeBuildCommand": "bun run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Recon \u2022 Stretched Resolution & Utility",
        "width": 1210,
        "height": 800,
        "minWidth": 1360,
        "minHeight": 850,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "",
        "url": "index.html#overlay",
        "create": false,
        "fullscreen": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "webview2-runtime"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "publisher": "Youssef Adel",
    "copyright": "Copyright \u00a9 2026 Youssef Adel. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Valorant Stretched Resolution & Scouting Utility",
    "longDescription": "Recon is a competitive stretched resolution utility and real-time scout for Valorant.",
    "homepage": "https://reconlab.app",
    "licenseFile": "../LICENSE",
    "externalBin": [
      "binaries/recon-overlay"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "resources": [
      "webview2-runtime/"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/youssefvdel/Recon/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3RkQ1MTYwRTJFQjE1RTYKUldUbUZldmlZRkg5ZC9BaktNanlMZ1NObWhpZkQ1cVpyM3Rzc0wxZnlDRVJEVWtmeFhweTlhK2sK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
