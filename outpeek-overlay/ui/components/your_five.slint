// 2/5 — Your-five roster. Lite: agent portraits + rank crests, no names,
// no stats — one glanceable row. Full adds name + agent + RR under each
// portrait. Fallback tiles sit UNDER the images, so a missing icon degrades
// to a "?" tile instead of popping layout.

import { Theme, TypeScale, Space, Shape } from "../tokens.slint";
import { Facts, PlayerFact } from "../facts.slint";
import { Plate } from "plate.slint";

component Cell inherits Rectangle {
    in property <PlayerFact> p;
    in property <bool> full: false;
    in property <length> cell: 72px;

    width: full ? cell + 16px : cell;
    height: full ? cell + 44px : cell + 20px;

    // Party spine — replaces the TS SVG bow arc (Slint has no dashed SVG
    // arcs; a 3px spine reads the same at HUD distance).
    if p.party > 0: Rectangle {
        x: 0px;
        y: 6px;
        width: 3px;
        height: parent.height - 12px;
        border-radius: 2px;
        background: p.party == 1 ? Theme.party-1 : p.party == 2 ? Theme.party-2 : Theme.party-3;
    }

    portrait := Rectangle {
        x: (parent.width - cell) / 2;
        y: 0px;
        width: cell;
        height: cell;
        border-radius: Shape.md;
        border-width: p.isme ? 2px : 1px;
        border-color: p.isme ? Theme.primary : p.locked ? Theme.primary : Theme.line-soft;
        background: Theme.container-high;
        // "?" fallback tile — covered when the cached icon loads.
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "?";
            font-family: Theme.font-display;
            font-size: 20px;
            font-weight: 800;
            color: Theme.ink-faint;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Image {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            source: p.icon;
            image-fit: cover;
            image-rendering: smooth;
        }
        // Rank crest overlapping bottom-right, with empty-slot fallback.
        crest-bg := Rectangle {
            x: parent.width - 30px;
            y: parent.height - 24px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line-soft;
        }
        Image {
            x: parent.width - 30px;
            y: parent.height - 24px;
            width: 28px;
            height: 28px;
            source: p.crest;
            image-fit: contain;
            image-rendering: smooth;
        }
        if p.rr >= 0 && p.rr <= 100: Text {
            x: parent.width - 30px;
            y: parent.height - 12px;
            width: 28px;
            text: p.rr;
            font-family: Theme.font-mono;
            font-size: 8px;
            font-weight: 800;
            color: Theme.primary;
            horizontal-alignment: center;
        }
    }

    if full: VerticalLayout {
        x: 0px;
        y: cell + 22px;
        width: parent.width;
        spacing: 0px;
        Text {
            text: p.name;
            font-family: Theme.font-body;
            font-size: TypeScale.caption;
            font-weight: 700;
            color: Theme.ink;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: p.agent;
            font-family: Theme.font-mono;
            font-size: TypeScale.micro;
            color: p.locked ? Theme.primary : Theme.amber;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component YourFive inherits Plate {
    in property <[PlayerFact]> players: Facts.your-five;
    in property <bool> full: false;
    in property <float> scale: 1.0;

    VerticalLayout {
        padding: Space.md;
        spacing: Space.sm;
        Text {
            text: "YOUR TEAM";
            font-family: Theme.font-mono;
            font-size: TypeScale.micro;
            font-weight: 700;
            letter-spacing: 1px;
            color: Theme.primary;
        }
        row := HorizontalLayout {
            spacing: Space.sm;
            alignment: center;
            for p in players: Cell { p: p; full: full; cell: Shape.portrait * scale; }
        }
    }
}
